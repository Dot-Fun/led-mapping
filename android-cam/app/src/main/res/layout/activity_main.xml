<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#100F0F">

    <TextureView
        android:id="@+id/texturePreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC100F0F"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dot"
                android:textColor="#FFFBED"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="fun"
                android:textColor="#FF3C00"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="LEDMAP CAM"
                android:textColor="#E9CF77"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtEndpoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="Starting HTTP server..."
            android:textColor="#E9CF77"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="monospace"
            android:text="Camera initializing..."
            android:textColor="#A69C95"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtRemote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="Studio: waiting for link..."
            android:textColor="#4ADE80"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E0100F0F"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Field Remote Controls: trigger scans & heatmap from ANY phone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnScan"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.5"
                android:backgroundTint="#FF3C00"
                android:text="⚡ SCAN ROUND"
                android:textColor="#FFFBED"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHeatmap"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#26211E"
                android:text="🎯 MAP"
                android:textColor="#FFFBED" />

            <Button
                android:id="@+id/btnUndo"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="0.85"
                android:backgroundTint="#26211E"
                android:text="↩"
                android:textColor="#FFFBED" />

            <Button
                android:id="@+id/btnFx"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="0.9"
                android:backgroundTint="#26211E"
                android:text="▶ FX"
                android:textColor="#E9CF77" />
        </LinearLayout>

        <!-- Camera Exposure / Dim / Wi-Fi Update Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLedPreset"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="#1E1A18"
                android:text="LED Lock"
                android:textColor="#DFD6CC" />

            <Button
                android:id="@+id/btnAuto"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1E1A18"
                android:text="Auto AE"
                android:textColor="#DFD6CC" />

            <Button
                android:id="@+id/btnDim"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="0.8"
                android:backgroundTint="#1E1A18"
                android:text="Dim"
                android:textColor="#DFD6CC" />

            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1E1A18"
                android:text="⬆ Update"
                android:textColor="#E9CF77" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
